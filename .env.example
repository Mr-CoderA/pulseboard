# Externally managed PostgreSQL (Neon, Supabase, RDS, …).
# Connections must use sslmode=require. Do not commit a value.
# Schema generate/check does not read this variable and never connects.
DATABASE_URL=

# External scheduler/queue for digest compilation and prompt delivery
# (e.g. Upstash QStash or Temporal Cloud). Do not commit values.
SCHEDULER_ENDPOINT=
SCHEDULER_KEY=

# Session signing material for better-auth. Injected at deploy time.
BETTER_AUTH_SECRET=

# HTTPS origin of the Pulseboard API (Fly.io). Used by the static app at
# runtime. Do not set a local fallback; leave empty until deploy.
PUBLIC_API_ORIGIN=
